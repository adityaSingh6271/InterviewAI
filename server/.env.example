# Copy this file to `.env` and fill in real values.
# The server validates the environment at boot (Standards PDF 23) and exits
# with a precise error if anything required is missing or invalid.
# Secrets have NO defaults - generate them, never commit them:
#   openssl rand -hex 32

# --- required ---------------------------------------------------------------

# PostgreSQL connection string (postgresql:// user:pass@host:port/db).
# Include ?sslmode=require for any hosted/remote database (Neon, RDS, ...);
# TLS is taken from this URL, never from NODE_ENV.
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_interviewer?sslmode=require

# JWT secrets, minimum 32 characters each (use different values!)
JWT_SECRET=replace-with-32-plus-random-characters-secret-a
JWT_REFRESH_SECRET=replace-with-32-plus-random-characters-secret-b

# --- optional (defaults shown) ---------------------------------------------

# HTTP port
PORT=4000

# development | test | production
NODE_ENV=development

# Origins allowed by CORS and accepted by the auth origin check - comma
# separated list, must match the frontend URL(s). In production every
# auth request must carry an Origin from this list (missing -> 403).
CLIENT_ORIGIN=http://localhost:3000

# bcrypt cost factor (Standards: >= 10)
BCRYPT_ROUNDS=10

# PostgreSQL pool size
DB_POOL_MAX=10

# Queries slower than this (ms) are logged at warn level
SLOW_QUERY_MS=200

# error | warn | info | debug  (default: debug in dev, info in production)
LOG_LEVEL=debug
