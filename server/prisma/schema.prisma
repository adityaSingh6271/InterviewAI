// InterviewAI schema - source of truth for table shapes.
//
// Architecture (per project decision): Prisma OWNS THE SCHEMA (this file +
// prisma/migrations/*.sql are applied with `prisma migrate`), but all runtime
// queries are hand-written SQL through the pg pool in src/repositories -
// Prisma Client is not used at runtime.
//
// Conventions beyond the original paste (needed for raw-SQL use):
// - @map/@@map: DB columns and tables are snake_case/plural so SQL needs no
//   quoting (matches Standards "SQL authoring" rules); field names in here
//   stay camelCase.
// - @db.Timestamptz: absolute instants - raw SQL round-trips them without
//   timezone skew (a plain timestamp would be re-read in the machine's local
//   tz and break lockout comparisons).
// - @default(dbgenerated("gen_random_uuid()")): UUIDs are generated by
//   PostgreSQL, so INSERTs may omit id (same intent as @default(uuid())).
// - Auth lives on Admin and Student: two portals, two tables. Both carry the
//   verified auth contract (refresh-token hash, lockout columns, citext email
//   for case-insensitive login); there is no shared users table.
//   Institute.joinCode is the invite code students enter at self-registration.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum AdminRole {
  SUPER_ADMIN
  ORG_ADMIN
  INSTITUTE_ADMIN
}

enum InterviewStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum RoundType {
  AI_CHAT
  CODING
  VIDEO_PROCTORED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  EVALUATED
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEWED
  REJECTED
}

// ==========================================
// MODELS
// ==========================================

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at") @db.Timestamptz

  institutes  Institute[]
  llmConfigs  OrganizationLLMConfig[]

  @@map("organizations")
  @@index([name])
}

model OrganizationLLMConfig {
  id              String   @id @default(dbgenerated("gen_random_uuid()"))
  organizationId  String   @map("organization_id")
  provider        String // e.g., OpenAI, Anthropic, Custom
  modelName       String   @map("model_name")
  apiKeyEncrypted String   @map("api_key_encrypted") // Store securely
  settings        Json? // temperature, max tokens, system prompts
  isActive        Boolean  @default(false) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @default(now()) @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_llm_configs")
  @@index([organizationId])
}

model Institute {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  organizationId String   @map("organization_id")
  name           String
  /// Invite code students enter at self-registration (matched with upper() in SQL).
  joinCode       String   @unique @map("join_code")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @default(now()) @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  admins       Admin[]
  students     Student[]
  interviews   Interview[]

  @@map("institutes")
  @@index([organizationId])
}

model Admin {
  id               String    @id @default(dbgenerated("gen_random_uuid()"))
  instituteId      String    @map("institute_id")
  name             String
  /// citext: case-insensitive uniqueness + login match (Standards prefer citext).
  email            String      @unique @db.Citext
  /// bcrypt hash, cost >= 10.
  passwordHash     String      @map("password_hash")
  role             AdminRole   @default(INSTITUTE_ADMIN)
  /// SHA-256 of the current refresh token; NULL = signed out.
  refreshTokenHash String?     @map("refresh_token_hash")
  failedAttempts   Int         @default(0) @map("failed_attempts")
  lockedUntil      DateTime?   @map("locked_until") @db.Timestamptz
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime    @updatedAt @default(now()) @map("updated_at") @db.Timestamptz

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@map("admins")
  @@index([instituteId])
  @@index([email])
}

model Student {
  id               String    @id @default(dbgenerated("gen_random_uuid()"))
  instituteId      String    @map("institute_id")
  name             String
  /// citext: case-insensitive uniqueness + login match (Standards prefer citext).
  email            String    @unique @db.Citext
  /// bcrypt hash, cost >= 10.
  passwordHash     String    @map("password_hash")
  /// SHA-256 of the current refresh token; NULL = signed out.
  refreshTokenHash String?   @map("refresh_token_hash")
  failedAttempts   Int       @default(0) @map("failed_attempts")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @default(now()) @map("updated_at") @db.Timestamptz

  institute    Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  applications StudentApplication[]
  roundAttempts RoundAttempt[]

  @@map("students")
  @@index([instituteId])
  @@index([email])
}

model Interview {
  id              String          @id @default(dbgenerated("gen_random_uuid()"))
  instituteId     String          @map("institute_id")
  title           String
  description     String? // Role overview
  jobRequirements String?         @map("job_requirements") // Skills, experience, qualifications
  status          InterviewStatus @default(DRAFT)
  // ---- Rich profile fields (student-portal wizard payload) ----
  targetRole             String?  @map("target_role")
  company                String?
  category               String?
  industry               String?
  experienceLevel        String?  @map("experience_level")
  sessionDurationMinutes Int?     @map("session_duration_minutes")
  eligibilityStatus      String?  @map("eligibility_status")
  /// Client-maintained progress percentage (0-100), refreshed on writes.
  overallProgress        Int      @default(0) @map("overall_progress")
  /// Wizard artifacts (ResumeReference / ExtractedJobData / ResumeMatchAnalysis).
  resume                 Json?
  extractedJobData       Json?    @map("extracted_job_data")
  matchAnalysis          Json?    @map("match_analysis")
  /// Creator (user id). Nullable for pre-existing rows. A student may only
  /// edit a DRAFT they created; admins may edit any row (see interview.service).
  createdBy              String?  @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @updatedAt @default(now()) @map("updated_at") @db.Timestamptz

  institute    Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  rounds       Round[]
  applications StudentApplication[]
  notes        InterviewNote[]

  @@map("interviews")
  @@index([instituteId])
  @@index([status])
  @@index([createdBy])
}

model StudentApplication {
  id            String           @id @default(dbgenerated("gen_random_uuid()"))
  interviewId   String           @map("interview_id")
  studentId     String           @map("student_id")
  resumeFileUrl String?          @map("resume_file_url") // S3/Storage link to PDF/DOCX
  resumeText    String?          @map("resume_text") // Pre-transcribed/parsed text for AI context
  status        ApplicationStatus @default(APPLIED)
  appliedAt     DateTime         @default(now()) @map("applied_at") @db.Timestamptz
  updatedAt     DateTime         @updatedAt @default(now()) @map("updated_at") @db.Timestamptz

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([interviewId, studentId]) // Prevent duplicate applications
  @@map("student_applications")
  @@index([interviewId])
  @@index([studentId])
}

model Round {
  id            String    @id @default(dbgenerated("gen_random_uuid()"))
  interviewId   String    @map("interview_id")
  name          String
  sequenceOrder Int       @map("sequence_order")
  roundType     RoundType @default(AI_CHAT) @map("round_type")
  /// Free-text round brief shown in the workspace.
  description                String? @default("")
  estimatedDurationMinutes   Int?    @map("estimated_duration_minutes")
  /// Client-side round taxonomy (aptitude/behavioral/...) - the canonical
  /// category stays in round_type; this keeps the student UI faithful.
  clientType   String?    @map("client_type")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @default(now()) @map("updated_at") @db.Timestamptz

  interview     Interview      @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  questions     Question[]
  roundAttempts RoundAttempt[]
  notes         InterviewNote[]

  @@map("rounds")
  @@index([interviewId])
  @@index([interviewId, sequenceOrder])
}

/// Free-form notes attached to an interview (optionally to one of its
/// rounds). `created_by` is the acting user's id - deliberately no FK,
/// because the author may live in either portal's table.
model InterviewNote {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  interviewId String   @map("interview_id")
  roundId     String?  @map("round_id")
  content     String
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @default(now()) @map("updated_at") @db.Timestamptz

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  round     Round?    @relation(fields: [roundId], references: [id], onDelete: SetNull)

  @@map("interview_notes")
  @@index([interviewId])
}

model Question {
  id              String     @id @default(dbgenerated("gen_random_uuid()"))
  roundId         String     @map("round_id")
  prompt          String
  expectedKeywords Json?     @map("expected_keywords") // Array of keywords for AI evaluation
  difficulty      Difficulty @default(MEDIUM)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @updatedAt @default(now()) @map("updated_at") @db.Timestamptz

  round     Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  responses Response[]

  @@map("questions")
  @@index([roundId])
}

model RoundAttempt {
  id            String        @id @default(dbgenerated("gen_random_uuid()"))
  roundId       String        @map("round_id")
  studentId     String        @map("student_id")
  attemptNumber Int           @default(1) @map("attempt_number")
  status        AttemptStatus @default(IN_PROGRESS)
  startedAt     DateTime      @default(now()) @map("started_at") @db.Timestamptz
  submittedAt   DateTime?     @map("submitted_at") @db.Timestamptz
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @default(now()) @map("updated_at") @db.Timestamptz

  round     Round      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  responses Response[]

  @@unique([roundId, studentId, attemptNumber])
  @@map("round_attempts")
  @@index([roundId])
  @@index([studentId])
}

model Response {
  id             String    @id @default(dbgenerated("gen_random_uuid()"))
  roundAttemptId String    @map("round_attempt_id")
  questionId     String    @map("question_id")
  transcript     String? // Speech-to-text output or typed text response
  aiScore        Float?    @map("ai_score") // Evaluated score
  aiFeedback     String?   @map("ai_feedback") // AI-generated qualitative feedback
  submittedAt    DateTime  @default(now()) @map("submitted_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @default(now()) @map("updated_at") @db.Timestamptz

  roundAttempt RoundAttempt @relation(fields: [roundAttemptId], references: [id], onDelete: Cascade)
  question     Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([roundAttemptId, questionId]) // One response per question per attempt
  @@map("responses")
  @@index([roundAttemptId])
  @@index([questionId])
}
