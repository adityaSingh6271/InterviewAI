# Copy to `.env.local` for local overrides, or set in Vercel Project Settings -> Environment Variables.

# Direct backend API base URL used by the browser (`client/lib/api/client.ts`).
# Recommended on Vercel production (set in Vercel Environment Variables):
#   NEXT_PUBLIC_API_BASE_URL=https://your-backend-domain.com/api/v1
# Note: Your backend `CLIENT_ORIGIN` MUST include your Vercel frontend URL (e.g. https://your-app.vercel.app)
# and `NODE_ENV=production` so CORS and `sameSite: "none"; secure` refresh cookies work.
# Leave unset in local dev to use Next.js same-origin rewrites to `API_ORIGIN` (`/api/v1/*`).
NEXT_PUBLIC_API_BASE_URL=

# Server-side Next.js rewrite target when NEXT_PUBLIC_API_BASE_URL is unset (defaults to http://localhost:4000).
API_ORIGIN=http://localhost:4000

